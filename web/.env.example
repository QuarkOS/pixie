# Pixie web app — placeholders only. Copy to .env and fill locally. Never commit real values.

DATA_DIR=./data
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Admin (use long random values in a real deployment)
ADMIN_PASSWORD=changeme
TOKEN_SECRET=changeme

CHAT_WORKER_KEY=changeme
TRAINING_INGEST_TOKEN=changeme

AUTH_DIR=./data/auth
AUTH_PUBLIC_URL=https://pixie.example.invalid
AUTH_COOKIE_SECURE=false
AUTH_SECRET=changeme

OWNER_EMAIL=owner@example.invalid
OWNER_LID=owner
OWNER_NAME=owner

# IANA timezone for the daily free-generation counter. Default in code is UTC.
PIXIE_TZ=UTC

# Optional: ISO timestamp; empty disables the grace window
AUTH_TOKEN_GRACE_UNTIL=

AUTH_MAILER=console
AUTH_RESEND_API_KEY=changeme
AUTH_FROM_EMAIL=noreply@example.invalid

AUTH_GOOGLE_CLIENT_ID=changeme
AUTH_GOOGLE_CLIENT_SECRET=changeme

AUTH_X_CLIENT_ID=changeme
AUTH_X_CLIENT_SECRET=changeme

CHAT_QUEUE_MAX=32
AB_SERVE=newest
