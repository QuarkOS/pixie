[Unit]
Description=Pixie web app (auth enabled, localhost unless you change the bind)
After=network-online.target
Wants=network-online.target

[Service]
# Example unit. Replace every /path/to/... before installing.
User=pixie
Group=pixie
WorkingDirectory=/path/to/pixie/web
EnvironmentFile=/path/to/pixie.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/path/to/pixie-data
PrivateTmp=true
# Bind address is set in the env file (127.0.0.1 unless you change it).

[Install]
WantedBy=multi-user.target
