[Unit]
Description=Pixie web app
After=network-online.target
Wants=network-online.target

[Service]
# Example unit. Replace every /path/to/... before installing.
User=pixie
Group=pixie
WorkingDirectory=/path/to/pixie/web
EnvironmentFile=/path/to/pixie.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/path/to/pixie-data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
